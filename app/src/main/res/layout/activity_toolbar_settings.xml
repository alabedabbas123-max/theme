<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:layoutDirection="rtl"
    android:orientation="vertical">
    <include layout="@layout/settings_page_header" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="اختر الأدوات الظاهرة في الشريط ورتبها بالأسهم. أول أربع أدوات ظاهرة تظهر مباشرة على الشريط."
                android:textColor="#667080"
                android:textSize="13sp" />
            <Button
                android:id="@+id/toolbar_reset"
                style="@style/SettingsSecondaryButton"
                android:text="إعادة تعيين الترتيب الافتراضي" />
            <LinearLayout
                android:id="@+id/toolbar_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
