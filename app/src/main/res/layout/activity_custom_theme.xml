<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:layoutDirection="ltr"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF">
        <ImageButton
            android:id="@+id/custom_theme_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="left|center_vertical"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="14dp"
            android:rotation="180"
            android:src="@drawable/ic_chevron_right" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="left|center_vertical"
            android:layout_marginLeft="62dp"
            android:gravity="left|center_vertical"
            android:text="Customization"
            android:textColor="#17191F"
            android:textSize="21sp" />
        <Button
            android:id="@+id/custom_theme_save"
            android:layout_width="92dp"
            android:layout_height="48dp"
            android:layout_gravity="right|center_vertical"
            android:layout_marginRight="14dp"
            android:background="@drawable/bg_custom_save_yellow"
            android:text="حفظ"
            android:textAllCaps="false"
            android:textColor="#17140A"
            android:textSize="16sp" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">
            <!-- Round 68: أربعة أقسام فقط — الخلفيات، Auto (التفاعلات)، الأزرار، الخط -->
            <LinearLayout
                android:id="@+id/tab_background_container"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/tab_background"
                    android:layout_width="44dp"
                    android:layout_height="46dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="الخلفيات"
                    android:padding="6dp"
                    android:src="@drawable/custom_skin_tab_sliding_unselect" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="الخلفيات"
                    android:textColor="#555B65"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tab_auto_container"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/tab_auto"
                    android:layout_width="44dp"
                    android:layout_height="46dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Auto"
                    android:padding="6dp"
                    android:src="@drawable/icon_diy_automatic" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="Auto"
                    android:textColor="#555B65"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tab_keys_container"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/tab_keys"
                    android:layout_width="44dp"
                    android:layout_height="46dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="الأزرار"
                    android:padding="6dp"
                    android:src="@drawable/custom_skin_tab_button_unselect" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="الأزرار"
                    android:textColor="#555B65"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tab_font_container"
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageButton
                    android:id="@+id/tab_font"
                    android:layout_width="44dp"
                    android:layout_height="46dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="الخط"
                    android:padding="6dp"
                    android:src="@drawable/custom_skin_tab_font_unselect" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="الخط"
                    android:textColor="#555B65"
                    android:textSize="11sp" />
            </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:id="@+id/content_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
            <EditText
                android:id="@+id/custom_theme_name"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
            <!-- ================== قسم الخلفيات: كلون أو كصورة ================== -->
            <LinearLayout
                android:id="@+id/section_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="right|center_vertical"
                    android:text="لون الخلفية"
                    android:textColor="#202124"
                    android:textSize="16sp" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/background_color_presets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="6dp" />
                </HorizontalScrollView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="right|center_vertical"
                    android:text="الخلفية كصورة — مدمجة أو من الجهاز"
                    android:textColor="#202124"
                    android:textSize="16sp" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/background_presets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
                <Button
                    android:id="@+id/theme_add_image"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:text="اختيار صورة من الجهاز" />
                <Button
                    android:id="@+id/theme_remove_image"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:text="إزالة الصورة" />
                <TextView
                    android:id="@+id/background_dim_value"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="right|center_vertical"
                    android:text="تعتيم/إضاءة الخلفية: بدون"
                    android:textColor="#424c58"
                    android:textSize="14sp" />
                <SeekBar
                    android:id="@+id/background_dim"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:max="160"
                    android:progress="80" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="right|center_vertical"
                    android:text="خلفيات متحركة"
                    android:textColor="#202124"
                    android:textSize="16sp" />
                <GridLayout
                    android:id="@+id/auto_theme_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:orientation="horizontal" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="right|center_vertical"
                    android:text="خلفيات مكتبة ثيماتي"
                    android:textColor="#202124"
                    android:textSize="16sp" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/designer_bg_sections_strip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="6dp" />
                </HorizontalScrollView>
                <GridLayout
                    android:id="@+id/designer_bg_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:orientation="horizontal" />
            </LinearLayout>
            <!-- ================== قسم Auto — التفاعلات ================== -->
            <LinearLayout
                android:id="@+id/section_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="right|center_vertical"
                    android:text="تفاعلات الضغط المتحركة"
                    android:textColor="#202124"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right|center_vertical"
                    android:paddingBottom="4dp"
                    android:text="قلوب وبوسات ونجوم تتناثر فوق المفتاح لحظة ضغطه — جرّب على المعاينة بالأسفل"
                    android:textColor="#5f6a7d"
                    android:textSize="12sp" />
                <GridLayout
                    android:id="@+id/pressfx_presets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:orientation="horizontal" />
            </LinearLayout>
            <!-- ================== قسم الخط — العائلة والأحجام وألوان الحروف ================== -->
            <LinearLayout
                android:id="@+id/section_font"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="right|center_vertical"
                    android:text="عائلة الخط"
                    android:textColor="#202124"
                    android:textSize="18sp" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/font_presets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
                <TextView
                    android:id="@+id/main_font_size_value"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="right|center_vertical"
                    android:text="حجم الحرف الرئيسي"
                    android:textColor="#424c58"
                    android:textSize="14sp" />
                <SeekBar
                    android:id="@+id/main_font_size"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:progressDrawable="@drawable/bg_seekbar_wide"
                    android:thumb="@drawable/bg_seekbar_wide_thumb"
                    android:max="12" />
                <TextView
                    android:id="@+id/sub_font_size_value"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="right|center_vertical"
                    android:text="حجم الحرف الصغير"
                    android:textColor="#424c58"
                    android:textSize="14sp" />
                <SeekBar
                    android:id="@+id/sub_font_size"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:progressDrawable="@drawable/bg_seekbar_wide"
                    android:thumb="@drawable/bg_seekbar_wide_thumb"
                    android:max="8" />
                <TextView
                    android:id="@+id/main_text_position_value"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="right|center_vertical"
                    android:text="موقع الحرف الرئيسي"
                    android:textColor="#424c58"
                    android:textSize="14sp" />
                <SeekBar
                    android:id="@+id/main_text_position"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:progressDrawable="@drawable/bg_seekbar_wide"
                    android:thumb="@drawable/bg_seekbar_wide_thumb"
                    android:max="40" />
                <TextView
                    android:id="@+id/sub_text_position_value"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="right|center_vertical"
                    android:text="موقع الحرف الصغير"
                    android:textColor="#424c58"
                    android:textSize="14sp" />
                <SeekBar
                    android:id="@+id/sub_text_position"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:progressDrawable="@drawable/bg_seekbar_wide"
                    android:thumb="@drawable/bg_seekbar_wide_thumb"
                    android:max="40" />
                <TextView
                    android:id="@+id/key_width_value"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="right|center_vertical"
                    android:text="عرض الزر"
                    android:textColor="#424c58"
                    android:textSize="14sp" />
                <SeekBar
                    android:id="@+id/key_width"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:progressDrawable="@drawable/bg_seekbar_wide"
                    android:thumb="@drawable/bg_seekbar_wide_thumb"
                    android:max="60" />
                <TextView
                    android:id="@+id/key_height_value"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="right|center_vertical"
                    android:text="ارتفاع الزر"
                    android:textColor="#424c58"
                    android:textSize="14sp" />
                <SeekBar
                    android:id="@+id/key_height"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:progressDrawable="@drawable/bg_seekbar_wide"
                    android:thumb="@drawable/bg_seekbar_wide_thumb"
                    android:max="60" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="right|center_vertical"
                    android:text="لون الخط في المفاتيح"
                    android:textColor="#202124"
                    android:textSize="16sp" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/text_color_presets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="6dp" />
                </HorizontalScrollView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="right|center_vertical"
                    android:text="لون الخط في الحروف الصغيرة"
                    android:textColor="#202124"
                    android:textSize="16sp" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/sub_color_presets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="6dp" />
                </HorizontalScrollView>
            </LinearLayout>
            <Button
                android:id="@+id/custom_theme_delete"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="حذف السمة المخصصة"
                android:textAllCaps="false"
                android:textColor="#B3261E"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
        <!-- ================== قسم الأزرار — الشفافية والأقسام ثابتان في الأعلى ================== -->
        <LinearLayout
            android:id="@+id/section_keys_fixed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/key_opacity_value"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="right|center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="شفافية الزر المختار: 0٪"
                android:textColor="#424c58"
                android:textSize="14sp" />
            <SeekBar
                android:id="@+id/key_opacity"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:max="100" />
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:background="#FFFFFF">
                <LinearLayout
                    android:id="@+id/button_sections_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="6dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="6dp" />
            </HorizontalScrollView>
            <ScrollView
                android:id="@+id/button_elements_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never">
                <GridLayout
                    android:id="@+id/button_elements_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:orientation="horizontal"
                    android:padding="12dp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161329"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/custom_preview_suggestions"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="الكتابة"
                android:textSize="15sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="اقتراح"
                android:textSize="15sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="الكلمة"
                android:textSize="15sp" />
        </LinearLayout>
        <com.almlk.swiftkey.ime.ThemeDecorationBarLayout
            android:id="@+id/custom_preview_toolbar"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageButton
                style="@style/ImeToolButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:src="@drawable/ic_more" />
            <ImageButton
                style="@style/ImeToolButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:src="@drawable/ic_search" />
            <ImageButton
                style="@style/ImeToolButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:src="@drawable/ic_mic" />
            <ImageButton
                style="@style/ImeToolButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:src="@drawable/ic_translate" />
            <ImageButton
                style="@style/ImeToolButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:src="@drawable/ic_clipboard" />
            <ImageButton
                style="@style/ImeToolButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:src="@drawable/ic_emoji" />
            <ImageButton
                style="@style/ImeToolButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:src="@drawable/ic_ai" />
            <ImageButton
                style="@style/ImeToolButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:src="@drawable/ic_settings" />
        </com.almlk.swiftkey.ime.ThemeDecorationBarLayout>
        <com.almlk.swiftkey.ime.SmartKeyboardView
            android:id="@+id/custom_theme_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
