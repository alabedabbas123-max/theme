<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="#FFFFFF"
        android:layoutDirection="rtl"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/tab_more"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/tab_more_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_settings" />
            <TextView
                android:id="@+id/tab_more_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المزيد من الإعدادات"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_stickers"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/tab_stickers_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_sticker" />
            <TextView
                android:id="@+id/tab_stickers_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الملصقات"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_shapes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/tab_shapes_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_palette" />
            <TextView
                android:id="@+id/tab_shapes_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الاشكال"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
