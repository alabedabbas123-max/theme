<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:layoutDirection="rtl"
    android:orientation="vertical">
    <include layout="@layout/settings_page_header" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView style="@style/SettingsSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp" android:text="خيارات شريط الاقتراحات" />
            <Switch android:id="@+id/suggestion_autocomplete" android:layout_width="match_parent" android:layout_height="50dp" android:text="إكمال الكلمات تلقائيًا دون تعطيل شريط الاقتراحات" />
            <Switch android:id="@+id/suggestion_space_autocomplete" android:layout_width="match_parent" android:layout_height="50dp" android:text="استخدام زر المسافة للإكمال التلقائي" />
            <Switch android:id="@+id/suggestion_autocorrect" android:layout_width="match_parent" android:layout_height="50dp" android:text="تمكين التصحيح التلقائي" />
            <Switch android:id="@+id/suggestion_learning" android:layout_width="match_parent" android:layout_height="50dp" android:text="تمكين التعلم المحلي" />
            <Switch android:id="@+id/suggestion_emoji" android:layout_width="match_parent" android:layout_height="50dp" android:text="تمكين اقتراحات Emoji" />
            <Button android:id="@+id/suggestion_open_dictionaries" style="@style/SettingsSecondaryButton" android:text="فتح القواميس وإدارة الكلمات" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
