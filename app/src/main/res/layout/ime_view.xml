<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ime_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- NOTE: <include> IGNORES layout_gravity unless the tag itself carries BOTH
         layout_width and layout_height — that silent drop pinned the block to the top of the
         full-height root and is what dragged growth to the bottom edge. Keep both set. -->
    <include
        android:id="@+id/main_keyboard_frame"
        layout="@layout/main_keyboard_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

    <include
        android:id="@+id/emoji_panel"
        layout="@layout/emoji_palettes_view"
        android:layout_width="match_parent"
        android:layout_height="350dp" />
    <!-- Round 70: لوحة متجر الملصقات -->
    <com.almlk.swiftkey.ime.StickerStorePanelView
        android:id="@+id/sticker_store_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />
    <!-- Resize scrim: wrap_content height on purpose — match_parent here makes a childless
         drawing view inflate the WHOLE root (07:15 regression). Its onMeasure adopts the block's
         measured height instead, so the root stays exactly as tall as the keyboard. -->
    <com.almlk.swiftkey.ime.KeyboardResizeOverlay
        android:id="@+id/keyboard_resize_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />
</FrameLayout>
