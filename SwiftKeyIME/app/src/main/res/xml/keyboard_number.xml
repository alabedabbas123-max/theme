<?xml version='1.0' encoding='UTF-8'?>
<Keyboard
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:keyHeight="57dp"
    app:horizontalGap="3dp"
    app:verticalGap="3dp">
    <Row app:rowEdgeFlags="top">
        <Key
            app:codes="1"
            app:keyLabel="1"
            app:keyWidth="25%p" />
        <Key
            app:codes="2"
            app:keyLabel="2"
            app:keyWidth="25%p" />
        <Key
            app:codes="3"
            app:keyLabel="3"
            app:keyWidth="25%p" />
        <Key
            app:codes="("
            app:keyLabel="(" />
        <Key
            app:codes=")"
            app:keyLabel=")" />
        <Key
            app:codes=","
            app:keyLabel="،" />
    </Row>
    <Row>
        <Key
            app:codes="4"
            app:keyLabel="4"
            app:keyWidth="25%p" />
        <Key
            app:codes="5"
            app:keyLabel="5"
            app:keyWidth="25%p" />
        <Key
            app:codes="6"
            app:keyLabel="6"
            app:keyWidth="25%p" />
        <Key
            app:codes="+"
            app:keyLabel="+" />
        <Key
            app:codes="-"
            app:keyLabel="-" />
        <Key
            app:codes=";"
            app:keyLabel="؛" />
    </Row>
    <Row>
        <Key
            app:codes="7"
            app:keyLabel="7"
            app:keyWidth="25%p" />
        <Key
            app:codes="8"
            app:keyLabel="8"
            app:keyWidth="25%p" />
        <Key
            app:codes="9"
            app:keyLabel="9"
            app:keyWidth="25%p" />
        <Key
            app:codes="/"
            app:keyLabel="/" />
        <Key
            app:codes="78"
            app:keyLabel="N" />
        <Key
            app:codes="-2"
            app:keyIcon="@drawable/ic_backspace"
            app:isRepeatable="true" />
    </Row>
    <Row app:rowEdgeFlags="bottom">
        <Key
            app:codes="*"
            app:keyLabel="*"
            app:keyWidth="25%p" />
        <Key
            app:codes="0"
            app:keyLabel="0"
            app:keyWidth="25%p" />
        <Key
            app:codes="\#"
            app:keyLabel="\#"
            app:keyWidth="25%p" />
        <Key
            app:codes="."
            app:keyLabel="." />
        <Key
            app:codes="0"
            app:keyLabel="" />
        <Key
            app:codes="-3"
            app:keyIcon="@drawable/ic_enter" />
    </Row>
</Keyboard>
