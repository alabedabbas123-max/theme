<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <size android:height="8dp" />
            <corners android:radius="4dp" />
            <solid android:color="#E1E7F0" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="8dp" />
                <corners android:radius="4dp" />
                <solid android:color="#C7D4E6" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="8dp" />
                <corners android:radius="4dp" />
                <solid android:color="#169BEA" />
            </shape>
        </clip>
    </item>
</layer-list>
