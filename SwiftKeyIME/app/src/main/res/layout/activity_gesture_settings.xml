<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:layoutDirection="rtl"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="#FFFFFF">
        <ImageButton
            android:id="@+id/gesture_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="right|center_vertical"
            android:background="@android:color/transparent"
            android:contentDescription="رجوع"
            android:padding="14dp"
            android:src="@drawable/ic_chevron_right" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="الكتابة بالإيماءات"
            android:textColor="#15171A"
            android:textSize="19sp" />
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#EAF2FF"
                android:padding="12dp"
                android:text="مرّر إصبعك فوق الحروف دون رفعه. تُحلل الحركة محليًا باستخدام القاموس والسياق، ولا تُرسل مسارات الكتابة إلى الإنترنت."
                android:textColor="#36506F"
                android:textSize="13sp" />
            <Switch
                android:id="@+id/setting_gesture_typing"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="تفعيل الكتابة بالسحب"
                android:textColor="#202124"
                android:textSize="15sp" />
            <Switch
                android:id="@+id/setting_gesture_auto_insert"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="إدخال أفضل اقتراح عند رفع الإصبع"
                android:textColor="#202124"
                android:textSize="14sp" />
            <Switch
                android:id="@+id/setting_gesture_trail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="إظهار خط تتبع السحب"
                android:textColor="#202124"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/gesture_sensitivity_label"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="right|bottom"
                android:textColor="#596170"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/setting_gesture_sensitivity"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:max="18" />
            <TextView
                android:id="@+id/gesture_width_label"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="right|bottom"
                android:textColor="#596170"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/setting_gesture_width"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:max="8" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:text="عند تعطيل الإدخال التلقائي تظهر أفضل الكلمات في شريط الاقتراحات، ويمكن إدخال الكلمة بلمسها. لا تعمل الإيماءات في كلمات المرور أو التخطيطات الرقمية والرموز."
                android:textColor="#6A7280"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
