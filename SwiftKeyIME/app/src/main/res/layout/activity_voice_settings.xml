<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:layoutDirection="rtl"
    android:orientation="vertical">
    <include layout="@layout/settings_page_header" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                style="@style/SettingsSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="زر الميكروفون" />
            <Switch
                android:id="@+id/voice_toolbar_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="إظهار زر الصوت في شريط الأدوات" />
            <TextView
                style="@style/SettingsSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="لغة التعرف على الكلام" />
            <RadioGroup
                android:id="@+id/voice_language_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/voice_language_auto"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="تلقائي حسب لغة الكيبورد" />
                <RadioButton
                    android:id="@+id/voice_language_ar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="العربية" />
                <RadioButton
                    android:id="@+id/voice_language_en"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="الإنجليزية" />
            </RadioGroup>
            <TextView
                style="@style/SettingsSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="إذن الميكروفون" />
            <TextView
                android:id="@+id/voice_permission_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:textColor="#667080"
                android:textSize="14sp" />
            <Button
                android:id="@+id/voice_permission_request"
                style="@style/SettingsPrimaryButton"
                android:text="منح إذن الميكروفون" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
