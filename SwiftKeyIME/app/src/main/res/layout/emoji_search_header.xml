<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emoji_search_header"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:padding="4dp">
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/emoji_search_results"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layoutDirection="rtl" />
        </HorizontalScrollView>
        <ImageButton
            android:id="@+id/emoji_search_back"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:padding="11dp"
            android:src="@drawable/ic_chevron_right"
            android:background="@drawable/bg_toolbar_toggle"
            android:contentDescription="العودة إلى لوحة الإيموجي" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:gravity="center_vertical"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:background="@drawable/bg_emoji_search">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_search" />
        <TextView
            android:id="@+id/emoji_search_query"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|right"
            android:singleLine="true"
            android:ellipsize="start"
            android:textSize="15sp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:hint="اكتب اسم الإيموجي بالعربية أو English أو الرمز" />
    </LinearLayout>
</LinearLayout>
