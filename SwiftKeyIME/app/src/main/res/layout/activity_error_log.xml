<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface"
    android:layoutDirection="rtl"
    android:paddingLeft="14dp"
    android:paddingTop="14dp"
    android:paddingRight="14dp"
    android:paddingBottom="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/error_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_chevron_right"
            android:padding="11dp"
            android:contentDescription="@string/error_back" />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/error_log_title"
            android:textColor="@color/text"
            android:textSize="21sp"
            android:textStyle="bold"
            android:gravity="right" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/error_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_error_status"
        android:textColor="@color/primary_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="right" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_error_console"
        android:fillViewport="true">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/error_log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D7E3F4"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textDirection="ltr"
            android:gravity="left|top"
            android:textIsSelectable="true" />
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/error_share"
            style="@style/SettingsPrimaryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/error_share" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/error_copy"
            style="@style/SettingsSecondaryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:text="@string/error_copy" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/error_clear"
            style="@style/SettingsSecondaryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/error_clear"
            android:textColor="#B3261E" />
    </LinearLayout>
</LinearLayout>
