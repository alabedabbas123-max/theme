<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:layoutDirection="rtl"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="#FFFFFF">
        <ImageButton
            android:id="@+id/feedback_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="right|center_vertical"
            android:background="@android:color/transparent"
            android:contentDescription="رجوع"
            android:padding="14dp"
            android:src="@drawable/ic_chevron_right" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="الصوت والاهتزاز والنوافذ"
            android:textColor="#15171A"
            android:textSize="19sp" />
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">
            <Switch
                android:id="@+id/setting_sound"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="صوت الضغط على المفاتيح"
                android:textColor="#202124"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/sound_volume_label"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="right|bottom"
                android:textColor="#596170"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/setting_sound_volume"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:max="95" />
            <Switch
                android:id="@+id/setting_vibration"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="الاهتزاز عند الضغط"
                android:textColor="#202124"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/vibration_strength_label"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="right|bottom"
                android:textColor="#596170"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/setting_vibration_strength"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:max="254" />
            <TextView
                android:id="@+id/vibration_duration_label"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="right|bottom"
                android:textColor="#596170"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/setting_vibration_duration"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:max="40" />
            <Button
                android:id="@+id/test_feedback"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="تجربة الصوت والاهتزاز"
                android:textAllCaps="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="right|bottom"
                android:text="نوافذ المفاتيح"
                android:textColor="#2E73DB"
                android:textSize="15sp" />
            <Switch
                android:id="@+id/setting_key_preview"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="إظهار تكبير الحرف عند الضغط"
                android:textColor="#202124"
                android:textSize="14sp" />
            <Switch
                android:id="@+id/setting_sticky_alternatives"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="تثبيت نافذة بدائل الحروف"
                android:textColor="#202124"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/popup_delay_label"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="right|bottom"
                android:textColor="#596170"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/setting_popup_delay"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:max="430" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="right|bottom"
                android:text="الحذف بالضغط المطول"
                android:textColor="#2E73DB"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/delete_speed_label"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="right|bottom"
                android:textColor="#596170"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/setting_delete_speed"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:max="58" />
            <TextView
                android:id="@+id/delete_delay_label"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="right|bottom"
                android:textColor="#596170"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/setting_delete_delay"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:max="280" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
