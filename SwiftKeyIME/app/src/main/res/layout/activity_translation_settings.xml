<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:layoutDirection="rtl"
    android:orientation="vertical">
    <include layout="@layout/settings_page_header" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                style="@style/SettingsSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="لغات الترجمة الافتراضية" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="الترجمة من:"
                android:textColor="#667080"
                android:textSize="14sp" />
            <Button
                android:id="@+id/translation_from"
                style="@style/SettingsSecondaryButton"
                android:text="العربية" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingBottom="4dp"
                android:text="الترجمة إلى:"
                android:textColor="#667080"
                android:textSize="14sp" />
            <Button
                android:id="@+id/translation_to"
                style="@style/SettingsSecondaryButton"
                android:text="English" />
            <Button
                android:id="@+id/translation_swap"
                style="@style/SettingsSecondaryButton"
                android:text="⇄   تبديل الاتجاه" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="تُستخدم هذه اللغات كنقطة بداية في أداة الترجمة على الكيبورد، ويمكن تغييرها من هناك في أي وقت."
                android:textColor="#777777"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
