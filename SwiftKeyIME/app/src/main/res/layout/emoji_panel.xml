<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emoji_panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#5D8FC9">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:gravity="center_vertical"
        android:padding="4dp">
        <ImageButton
            android:id="@+id/emoji_ai"
            style="@style/EmojiTopButton"
            android:src="@drawable/ic_ai"
            android:contentDescription="المساعد الذكي" />
        <ImageButton
            android:id="@+id/emoji_stickers"
            style="@style/EmojiTopButton"
            android:src="@drawable/ic_sticker"
            android:contentDescription="الملصقات" />
        <ImageButton
            android:id="@+id/emoji_gif"
            style="@style/EmojiTopButton"
            android:src="@drawable/ic_gif"
            android:contentDescription="GIF" />
        <ImageButton
            android:id="@+id/emoji_selected"
            style="@style/EmojiTopButton"
            android:src="@drawable/ic_emoji"
            android:contentDescription="الإيموجي" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <ImageButton
            android:id="@+id/emoji_keyboard_top"
            android:layout_width="38dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:src="@drawable/ic_chevron_right"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="العودة إلى لوحة الكتابة" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:padding="5dp">
        <EditText
            android:id="@+id/emoji_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:singleLine="true"
            android:textSize="14sp"
            android:hint="ابحث بالعربية أو English أو بالرمز"
            android:gravity="center_vertical|right"
            android:paddingLeft="12dp"
            android:paddingRight="42dp"
            android:background="@drawable/bg_emoji_search" />
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="right|center_vertical"
            android:layout_marginRight="12dp"
            android:src="@drawable/ic_search" />
    </FrameLayout>
    <GridView
        android:id="@+id/emoji_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="8"
        android:verticalSpacing="2dp"
        android:horizontalSpacing="2dp"
        android:padding="5dp"
        android:clipToPadding="false"
        android:stretchMode="columnWidth" />
    <LinearLayout
        android:id="@+id/emoji_categories"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:gravity="center"
        android:padding="3dp" />
</LinearLayout>
