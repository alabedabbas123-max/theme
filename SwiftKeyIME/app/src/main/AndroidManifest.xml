<?xml version='1.0' encoding='UTF-8'?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.almlk.swiftkey">
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Round 57: فحص حالة الشبكة عند فتح التطبيق (بوابة الإنترنت) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application
        android:name="com.almlk.swiftkey.AlmlkApplication"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:name="com.almlk.swiftkey.settings.SettingsActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.almlk.swiftkey.settings.ThemeSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.almlk.swiftkey.settings.CustomThemeActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.CustomBackgroundActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.FeedbackSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.GestureSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.TypingSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.SuggestionSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.DictionarySettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.LanguageSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.AddLanguageActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.LayoutsSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.ClipboardSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.VoiceSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.FontSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.ToolbarSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.ShortcutSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.ShortcutOptionsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.DictionaryOptionsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.ClipboardOptionsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.TranslationSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.StickersActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.almlk.swiftkey.settings.VoicePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="com.almlk.swiftkey.diagnostics.ErrorLogActivity"
            android:exported="false"
            android:label="@string/error_log_title"
            android:theme="@style/AppTheme" />
        <meta-data
            android:name="com.almlk.swiftkey.LOCAL_ERROR_TRACKING"
            android:value="enabled" />
        <service
            android:name="com.almlk.swiftkey.ime.AlmlkImeService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:stopWithTask="false"
            android:theme="@style/ImeTheme">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
